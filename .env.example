POSTGRES_USER=mobility
POSTGRES_PASSWORD=mobility
POSTGRES_DB=mobility_tracker
DATABASE_URL=postgresql://mobility:mobility@db:5432/mobility_tracker

# Enrichment: "mock" (fake data) or "apollo" (real lookups)
ENRICHMENT_PROVIDER=mock
APOLLO_API_KEY=

# Email notifications for job changes
NOTIFY_EMAIL=

# Preferred transport: Resend (HTTPS — works on Railway, which blocks SMTP).
# RESEND_FROM must be on a verified domain to reach arbitrary recipients;
# the default onboarding@resend.dev can only deliver to the account owner.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Fallback transport: SMTP (blocked on Railway; fine for local/dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
